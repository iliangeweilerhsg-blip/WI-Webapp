{
  "name": "@sg/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Studien-Gehirn Core: Fastify-API, Drizzle-Schema und Migrationen",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "migrate": "node src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run test/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.9.3",
    "@sg/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
