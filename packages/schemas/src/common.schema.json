{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemeinsame Typen",
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUIDv7 (03 §1), Kleinbuchstaben"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601, UTC"
    },
    "IsoDate": {
      "type": "string",
      "format": "date"
    },
    "Lang": {
      "type": "string",
      "enum": ["de", "en", "mixed"]
    },
    "ModuleColor": {
      "type": "string",
      "description": "Token aus der festen Palette mit 12 Tönen (07 §8), Werte in packages/ui-tokens",
      "enum": [
        "mod-01",
        "mod-02",
        "mod-03",
        "mod-04",
        "mod-05",
        "mod-06",
        "mod-07",
        "mod-08",
        "mod-09",
        "mod-10",
        "mod-11",
        "mod-12"
      ]
    },
    "ApiError": {
      "type": "object",
      "description": "Fehlerformat der REST-API (08 §1)",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiErrorBody"
        }
      }
    },
    "BBox": {
      "type": "array",
      "description": "[x, y, w, h] in pt",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "ApiErrorBody": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "examples": ["slide_deck_not_found"]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Health": {
      "type": "object",
      "description": "Antwort von GET /api/v1/health (docs/VERTRAEGE.md §2)",
      "required": ["status", "db", "version"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok"]
        },
        "db": {
          "type": "string",
          "enum": ["ok", "fehler"]
        },
        "version": {
          "type": "string"
        }
      }
    },
    "EpochMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Epochen-Millisekunden (UTC) nach der synchronisierten Uhr (02 §5). Nur im Sync-Protokoll und im Strich-Format (08 §1)."
    },
    "SessionMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Sitzungszeit in ms seit session.started_at (02 §5). Clients setzen negative Werte (Uhrversatz) auf 0."
    },
    "HexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$",
      "description": "RGBA als #RRGGBBAA",
      "examples": ["#1E2A44FF"]
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256, hex, Kleinbuchstaben"
    },
    "ClientDevice": {
      "type": "string",
      "enum": ["mac", "ipad"],
      "description": "Gerät, auf dem ein Ereignis entstanden ist"
    },
    "Point2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[x, y] in pt"
    },
    "FileRef": {
      "type": "object",
      "description": "Verweis auf eine Datei, die getrennt per HTTP hochgeladen wird (08 §2.3 file_ref / pkdrawing_ref). Der Core prüft sha256 beim Upload.",
      "required": ["sha256", "mime", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "mime": {
          "type": "string",
          "minLength": 1,
          "examples": ["image/heic"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "FileReceipt": {
      "type": "object",
      "description": "Antwort auf PUT /photos/{id}/file und PUT /pages/{id}/pkdrawing",
      "required": ["id", "sha256", "size_bytes", "received_at", "duplicate"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "duplicate": {
          "type": "boolean",
          "description": "true: dieselbe Datei (gleiches sha256) lag schon vor, nichts geändert"
        }
      }
    }
  }
}
