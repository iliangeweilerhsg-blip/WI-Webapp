{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material: Foliensätze, Folien, Übungsblätter, Aufgaben (03 §4, F-ORG-02..04)",
  "$defs": {
    "IngestState": {
      "type": "string",
      "enum": ["neu", "verarbeitet", "fehler"]
    },
    "SlideDeck": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "created_at",
        "updated_at",
        "deleted_at",
        "module_id",
        "session_id",
        "title",
        "sha256",
        "page_count",
        "uploaded_at",
        "ingest_state"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "deleted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_id": {
          "$ref": "#/$defs/Uuid"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "null bis pdf.ingest gelaufen ist"
        },
        "uploaded_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "ingest_state": {
          "$ref": "#/$defs/IngestState"
        }
      }
    },
    "TextBlock": {
      "type": "object",
      "required": ["text", "bbox"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        }
      }
    },
    "Slide": {
      "type": "object",
      "description": "Eine Seite eines Foliensatzes. Bilder über GET /slides/{id}/image bzw. /thumb.",
      "required": [
        "id",
        "user_id",
        "created_at",
        "updated_at",
        "deleted_at",
        "deck_id",
        "index",
        "width_pt",
        "height_pt",
        "text",
        "text_blocks",
        "vision_summary",
        "title",
        "chapter"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "deleted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "deck_id": {
          "$ref": "#/$defs/Uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-basiert"
        },
        "width_pt": {
          "type": "number"
        },
        "height_pt": {
          "type": "number"
        },
        "text": {
          "type": "string",
          "description": "Textlayer, leer wenn keiner vorhanden"
        },
        "text_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextBlock"
          }
        },
        "vision_summary": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "chapter": {
          "type": ["string", "null"]
        }
      }
    },
    "SlideDeckDetail": {
      "type": "object",
      "required": ["deck", "slides"],
      "additionalProperties": false,
      "properties": {
        "deck": {
          "$ref": "#/$defs/SlideDeck"
        },
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slide"
          }
        }
      }
    },
    "SlideDeckList": {
      "type": "object",
      "required": ["items", "next_cursor"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideDeck"
          }
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      }
    },
    "UploadResult": {
      "type": "object",
      "description": "Antwort auf POST /slide-decks und POST /exercise-sheets. duplicate=true: Datei mit gleichem sha256 existiert schon, es wurde nichts angelegt (F-ORG-02 Sonderfall). id ist die ID des neuen bzw. bereits vorhandenen Objekts.",
      "required": ["id", "duplicate"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "duplicate": {
          "type": "boolean"
        }
      }
    },
    "ExerciseSheet": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "created_at",
        "updated_at",
        "deleted_at",
        "module_id",
        "title",
        "number",
        "sha256",
        "page_count",
        "due_at",
        "has_solution",
        "ingest_state"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "deleted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_id": {
          "$ref": "#/$defs/Uuid"
        },
        "title": {
          "type": "string"
        },
        "number": {
          "type": ["integer", "null"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "due_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Abgabe, geht in den Planer"
        },
        "has_solution": {
          "type": "boolean",
          "description": "Musterlösung hinterlegt (F-ORG-05, Phase 3)"
        },
        "ingest_state": {
          "$ref": "#/$defs/IngestState"
        }
      },
      "description": "Übungsblatt. Ergänzung zu 03 §4: ingest_state zeigt den Fortschritt von pdf.ingest für das Blatt."
    },
    "ExerciseSheetUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "number": {
          "type": ["integer", "null"]
        },
        "due_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ExerciseSheetList": {
      "type": "object",
      "required": ["items", "next_cursor"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExerciseSheet"
          }
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      }
    },
    "Task": {
      "type": "object",
      "description": "Teilaufgabe eines Übungsblatts. Zerlegung erst ab Phase 2 (F-ORG-03).",
      "required": [
        "id",
        "user_id",
        "created_at",
        "updated_at",
        "deleted_at",
        "sheet_id",
        "label",
        "page_index",
        "bbox",
        "text",
        "solution_text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "#/$defs/Uuid"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "deleted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "sheet_id": {
          "$ref": "#/$defs/Uuid"
        },
        "label": {
          "type": "string",
          "examples": ["2b"]
        },
        "page_index": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "solution_text": {
          "type": ["string", "null"]
        }
      }
    },
    "SlideDeckUpdate": {
      "type": "object",
      "description": "PATCH /slide-decks/{id}",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
