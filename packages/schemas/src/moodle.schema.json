{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moodle-Anbindung (F-MDL-01..06, 08 §9)",
  "$defs": {
    "MoodleConnectionState": {
      "type": "string",
      "enum": ["nicht_eingerichtet", "ok", "laeuft_bald_ab", "abgelaufen", "ungueltig", "nicht_erreichbar"],
      "description": "Zustand des Moodle-Zugangs (F-MDL-01)"
    },
    "MoodleStatus": {
      "type": "object",
      "description": "Antwort von GET /moodle/status (08 §9.2)",
      "required": ["state", "site_url", "site_name", "user_fullname", "token_valid_until", "checked_at"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/MoodleConnectionState"
        },
        "site_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "site_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_fullname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "token_valid_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MoodleFile": {
      "type": "object",
      "description": "Datei in Moodle (Aktivität, Anhang, Abgabe)",
      "required": ["ref", "filename", "mime_type", "size_bytes", "modified_at"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^/",
          "description": "Pfad hinter webservice/pluginfile.php, für GET /moodle/file?ref"
        },
        "filename": {
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "modified_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MoodleCourse": {
      "type": "object",
      "description": "Kurs, in den der Nutzer eingeschrieben ist. module_id: bestätigte Zuordnung zu einem Modul (F-MDL-03, T1-23)",
      "required": [
        "moodle_id",
        "short_name",
        "full_name",
        "start_date",
        "end_date",
        "url",
        "last_access_at",
        "module_id",
        "suggested_module_id",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "moodle_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "short_name": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "start_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "last_access_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_module_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vorschlag über Titelähnlichkeit, nur ohne bestätigte Zuordnung und nur für aktuelle Kurse (F-MDL-03)"
        },
        "category": {
          "$ref": "#/$defs/MoodleCourseCategory"
        }
      }
    },
    "MoodleCourseList": {
      "type": "object",
      "description": "Antwort von GET /moodle/courses",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoodleCourse"
          }
        }
      }
    },
    "MoodleCourseCategory": {
      "type": "string",
      "enum": ["aktuell", "organisatorisch", "alt"],
      "description": "aktuell = wird vorgeschlagen. organisatorisch (z. B. „Klausurtermine …“) und alt (Start vor dem aktuellen Semester) werden standardmäßig nicht vorgeschlagen (F-MDL-03)"
    },
    "MoodleCourseLink": {
      "type": "object",
      "description": "Bestätigte Zuordnung Moodle-Kurs → Modul (F-MDL-03, 08 §9.4 moodle_course_link)",
      "required": [
        "moodle_course_id",
        "module_id",
        "sync_enabled",
        "last_synced_at",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "moodle_course_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "module_id": {
          "$ref": "#/$defs/Uuid"
        },
        "sync_enabled": {
          "type": "boolean",
          "description": "false = Kurs bleibt zugeordnet, wird aber nicht abgeglichen"
        },
        "last_synced_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Letzter erfolgreicher Abgleich dieses Kurses"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "MoodleCourseLinkList": {
      "type": "object",
      "description": "Antwort von GET /moodle/links",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoodleCourseLink"
          }
        }
      }
    },
    "MoodleCourseLinkUpdate": {
      "type": "object",
      "description": "Body von PUT /moodle/links/{course_id}: Zuordnung bestätigen oder ändern",
      "required": ["module_id"],
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "$ref": "#/$defs/Uuid"
        },
        "sync_enabled": {
          "type": "boolean",
          "description": "Standard: true beim Anlegen, sonst unverändert"
        }
      }
    },
    "MoodleItemKind": {
      "type": "string",
      "enum": ["folien", "uebung", "ignoriert", "offen"],
      "description": "Einordnung einer Datei aus Moodle (F-MDL-04). offen = wartet auf die Entscheidung in der Inbox"
    },
    "MoodleItem": {
      "type": "object",
      "description": "Datei aus einem zugeordneten Kurs (08 §9.4 moodle_item). Wiedererkannt über file_ref",
      "required": [
        "id",
        "moodle_course_id",
        "module_id",
        "cmid",
        "activity_name",
        "filename",
        "file_ref",
        "mime_type",
        "is_pdf",
        "size_bytes",
        "modified_at",
        "kind",
        "kind_source",
        "slide_deck_id",
        "exercise_sheet_id",
        "removed_in_moodle_at",
        "last_error",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "moodle_course_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "module_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Modul aus der aktuellen Kurszuordnung, null ohne Zuordnung"
        },
        "cmid": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "activity_name": {
          "type": "string"
        },
        "filename": {
          "type": "string",
          "description": "Bereinigter Moodle-Dateiname, höchstens 255 Byte (UTF-8), Endung bleibt. Nur zur Anzeige"
        },
        "file_ref": {
          "type": "string",
          "pattern": "^/",
          "description": "Für GET /moodle/file?ref"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_pdf": {
          "type": "boolean",
          "description": "Nur PDFs werden übernommen, andere Dateien nur aufgelistet"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "modified_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "timemodified der zuletzt verarbeiteten Fassung"
        },
        "kind": {
          "$ref": "#/$defs/MoodleItemKind"
        },
        "kind_source": {
          "type": "string",
          "enum": ["auto", "manuell"],
          "description": "manuell = Entscheidung in der Inbox, gilt für die ganze Aktivität"
        },
        "slide_deck_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "exercise_sheet_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed_in_moodle_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "In Moodle gelöscht oder versteckt. Lokal wird nie gelöscht"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["kein_pdf", "zu_gross", "nicht_gefunden", "download_fehlgeschlagen"]
            },
            {
              "type": "null"
            }
          ],
          "description": "Warum die Datei zuletzt nicht übernommen wurde. Ein späterer Abgleich versucht es erneut (außer kein_pdf)"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "MoodleItemList": {
      "type": "object",
      "description": "Antwort von GET /moodle/items",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoodleItem"
          }
        }
      }
    },
    "MoodleItemUpdate": {
      "type": "object",
      "description": "Body von PATCH /moodle/items/{id}: Entscheidung aus der Inbox („Als Folien / Übung / ignorieren“, gilt für die ganze Aktivität). offen = Entscheidung rückgängig machen (R15)",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["folien", "uebung", "ignoriert", "offen"]
        }
      }
    },
    "MoodleSyncState": {
      "type": "string",
      "enum": ["aus", "bereit", "laeuft", "pausiert"],
      "description": "aus = Moodle nicht eingerichtet. pausiert = Token ungültig oder abgelaufen (F-MDL-01), der Abgleich wartet auf einen neuen Token"
    },
    "MoodleSyncTrigger": {
      "type": "string",
      "enum": ["start", "zeitplan", "manuell", "entscheidung", "zuordnung"],
      "description": "Anlass eines Abgleichs"
    },
    "MoodleSyncRun": {
      "type": "object",
      "description": "Ergebnis eines Abgleichs (F-MDL-04)",
      "required": [
        "trigger",
        "started_at",
        "finished_at",
        "ok",
        "error_code",
        "courses",
        "files_new",
        "files_changed",
        "files_imported",
        "inbox_new",
        "deadlines",
        "failed_courses"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "$ref": "#/$defs/MoodleSyncTrigger"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "type": "boolean",
          "description": "false = mindestens ein Kurs oder die Fristen konnten nicht abgeglichen werden"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fehlercode des Core (08 §9.1), z. B. moodle_unreachable, oder abgebrochen (Core wurde beendet)"
        },
        "courses": {
          "type": "integer",
          "minimum": 0,
          "description": "Abgeglichene Kurse"
        },
        "files_new": {
          "type": "integer",
          "minimum": 0
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "files_imported": {
          "type": "integer",
          "minimum": 0,
          "description": "Als Foliensatz oder Übungsblatt übernommen (inkl. Verknüpfung mit schon vorhandener Datei)"
        },
        "inbox_new": {
          "type": "integer",
          "minimum": 0,
          "description": "Neue Dateien mit kind = offen"
        },
        "deadlines": {
          "type": "integer",
          "minimum": 0,
          "description": "Aktuelle Fristen nach dem Abgleich"
        },
        "failed_courses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "description": "Moodle-ID"
          }
        }
      }
    },
    "MoodleSyncStatus": {
      "type": "object",
      "description": "Antwort von GET und POST /moodle/sync",
      "required": ["state", "connection", "last_run", "next_run_at"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/MoodleSyncState"
        },
        "connection": {
          "$ref": "#/$defs/MoodleConnectionState"
        },
        "last_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoodleSyncRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_run_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Nächster geplanter Abgleich (alle 2 h), null ohne Zeitplan"
        }
      }
    },
    "MoodleSyncRequest": {
      "type": "object",
      "description": "Body von POST /moodle/sync („Jetzt abgleichen“). Ohne course_id alle zugeordneten Kurse",
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        }
      }
    },
    "MoodleSyncedDeadline": {
      "type": "object",
      "description": "Frist aus dem Abgleich (08 §9.4 moodle_deadline). aufgabe = Moodle-Aufgabe mit Abgabedatum, termin = Kalenderereignis",
      "required": [
        "id",
        "source",
        "moodle_course_id",
        "module_id",
        "assignment_id",
        "event_id",
        "cmid",
        "name",
        "due_at",
        "url",
        "exercise_sheet_id",
        "removed_in_moodle_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "source": {
          "type": "string",
          "enum": ["aufgabe", "termin"]
        },
        "moodle_course_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "module_id": {
          "$ref": "#/$defs/Uuid"
        },
        "assignment_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "Moodle-ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "Moodle-ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "cmid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "Moodle-ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "due_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "exercise_sheet_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Übungsblatt, das dieses Abgabedatum bekommen hat"
        },
        "removed_in_moodle_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MoodleSyncedDeadlineList": {
      "type": "object",
      "description": "Antwort von GET /moodle/synced-deadlines",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoodleSyncedDeadline"
          }
        }
      }
    },
    "MoodleCompletion": {
      "type": "string",
      "enum": ["offen", "erledigt"],
      "description": "Erledigt-Status einer Aktivität"
    },
    "MoodleActivity": {
      "type": "object",
      "description": "Element eines Kursabschnitts",
      "required": [
        "cmid",
        "type",
        "name",
        "url",
        "visible",
        "description_html",
        "completion",
        "completion_manual",
        "instance_id",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "cmid": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "type": {
          "type": "string",
          "description": "Moodle-modname, z. B. resource, folder, assign, forum, quiz, url, page, label"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "description_html": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoodleCompletion"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_manual": {
          "type": "boolean",
          "description": "true = der Nutzer darf den Status selbst setzen (completion.set)"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "Moodle-ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoodleFile"
          }
        }
      }
    },
    "MoodleSection": {
      "type": "object",
      "required": ["moodle_id", "index", "name", "visible", "activities"],
      "additionalProperties": false,
      "properties": {
        "moodle_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoodleActivity"
          }
        }
      }
    },
    "MoodleCourseContents": {
      "type": "object",
      "description": "Antwort von GET /moodle/courses/{course_id}/contents",
      "required": ["course_id", "sections"],
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoodleSection"
          }
        }
      }
    },
    "MoodleAssignment": {
      "type": "object",
      "description": "Aufgabe mit Abgabe",
      "required": [
        "moodle_id",
        "cmid",
        "course_id",
        "name",
        "due_at",
        "cutoff_at",
        "opens_at",
        "intro_html",
        "intro_files",
        "submission_types",
        "requires_statement",
        "requires_submit"
      ],
      "additionalProperties": false,
      "properties": {
        "moodle_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "cmid": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "course_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Moodle-ID"
        },
        "name": {
          "type": "string"
        },
        "due_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "cutoff_at": {
          "anyOf": [
            {
