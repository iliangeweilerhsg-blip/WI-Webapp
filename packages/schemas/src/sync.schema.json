          "$ref": "#/$defs/SyncConnectionEvent"
        },
        {
          "$ref": "#/$defs/SyncPairingEvent"
        },
        {
          "$ref": "#/$defs/SyncNotebookChangedEvent"
        }
      ]
    },
    "SyncClientMessage": {
      "description": "Alle Nachrichten Client → Server",
      "anyOf": [
        {
          "$ref": "#/$defs/SyncHello"
        },
        {
          "$ref": "#/$defs/SyncSubscribe"
        },
        {
          "$ref": "#/$defs/SyncUnsubscribe"
        },
        {
          "$ref": "#/$defs/SyncTimePing"
        },
        {
          "$ref": "#/$defs/SyncTimeOffset"
        },
        {
          "$ref": "#/$defs/SyncPing"
        },
        {
          "$ref": "#/$defs/SyncPresence"
        },
        {
          "$ref": "#/$defs/SyncOp"
        }
      ]
    },
    "SyncServerMessage": {
      "description": "Alle Nachrichten Server → Client",
      "anyOf": [
        {
          "$ref": "#/$defs/SyncWelcome"
        },
        {
          "$ref": "#/$defs/SyncSubscribed"
        },
        {
          "$ref": "#/$defs/SyncAck"
        },
        {
          "$ref": "#/$defs/SyncOp"
        },
        {
