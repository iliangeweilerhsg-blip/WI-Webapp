    "NotebookCreateData": {
      "type": "object",
      "description": "Freies Notizbuch offline anlegen (F-INK-02, F-INK-14). Strom notebook:<notebook_id>, idempotent über notebook_id.",
      "required": ["notebook_id", "module_id", "title", "created_at"],
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "$ref": "#/$defs/Uuid"
        },
        "module_id": {
          "$ref": "#/$defs/Uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "frei",
          "description": "Nur frei. Die Notizbücher vorlesung/uebung legt der Core an"
        },
        "created_at": {
          "$ref": "#/$defs/EpochMs"
        }
      }
    },
    "PhotoFileRef": {
      "type": "object",
      "description": "Datei eines Tafel-Fotos, hochgeladen per PUT /photos/{photo_id}/file",
      "required": ["sha256", "mime", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "mime": {
          "$ref": "#/$defs/PhotoMime"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "NotebookUpdateFields": {
      "type": "object",
      "description": "Aktueller Stand der per REST änderbaren Felder",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "module_id": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": ["title", "module_id"]
    },
    "NotebookUpdateData": {
      "type": "object",
      "required": ["notebook_id", "fields"],
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "$ref": "#/$defs/Uuid"
        },
        "fields": {
          "$ref": "#/$defs/NotebookUpdateFields"
        }
      }
    },
    "NotebookRefData": {
      "type": "object",
      "required": ["notebook_id"],
      "additionalProperties": false,
      "properties": {
        "notebook_id": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "PageRefData": {
      "type": "object",
      "required": ["page_id"],
      "additionalProperties": false,
      "properties": {
