{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Einstellungen (F-EIN-01, Phase-1-Bereiche) und Modul-Einstellungen (W-06)",
  "$defs": {
    "Appearance": {
      "type": "string",
      "enum": ["hell", "dunkel", "system"]
    },
    "DashboardLayout": {
      "type": "string",
      "enum": ["standard", "folie_gross", "notizen_gross", "fokus"],
      "description": "Layout-Vorlagen F-DSH-01"
    },
    "InkMode": {
      "type": "string",
      "enum": ["freie_seite", "auf_folie"],
      "description": "Schreibmodus F-INK-03"
    },
    "ToolbarSide": {
      "type": "string",
      "enum": ["links", "rechts"],
      "description": "Händigkeit: Seite der Werkzeugleiste auf dem iPad"
    },
    "PencilDoubleTapAction": {
      "type": "string",
      "enum": ["radierer", "letztes_werkzeug", "farbpalette", "system", "aus"],
      "description": "system = Einstellung von iPadOS übernehmen"
    },
    "PencilSqueezeAction": {
      "type": "string",
      "enum": ["werkzeugpalette", "radierer", "system", "aus"]
    },
    "ColumnWidths": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Spaltenbreiten Folie | Übung | Notizen in Prozent, Summe 100"
    },
    "GeneralSettings": {
      "type": "object",
      "required": ["data_dir", "content_lang", "appearance"],
      "additionalProperties": false,
      "properties": {
        "data_dir": {
          "type": "string",
          "description": "SG_DATA_DIR, nur lesbar (Änderung über die Umgebung und Neustart)"
        },
        "content_lang": {
          "$ref": "#/$defs/Lang"
        },
        "appearance": {
          "$ref": "#/$defs/Appearance"
        }
      }
    },
    "LectureSettings": {
      "type": "object",
      "required": [
        "microphone_id",
        "auto_stop_after_end_min",
        "auto_stop_quiet_window_min",
        "auto_stop_hard_after_end_min",
        "auto_stop_silence_min",
        "auto_stop_max_duration_min",
        "auto_stop_warning_s",
        "auto_stop_extend_min",
        "default_layout",
        "default_ink_mode",
        "toolbar_side"
      ],
      "additionalProperties": false,
      "properties": {
        "microphone_id": {
          "type": ["string", "null"],
          "maxLength": 256,
          "description": "deviceId aus MediaDevices, null = Standardmikrofon"
        },
        "auto_stop_after_end_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 1: Kalenderende + X min … (Standard 10)"
        },
        "auto_stop_quiet_window_min": {
          "type": "integer",
          "minimum": 1,
          "description": "… und X min keine Sprache (Standard 3)"
        },
        "auto_stop_hard_after_end_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 2: Kalenderende + X min (Standard 30)"
        },
        "auto_stop_silence_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 3: Stille ≥ X min (Standard 15)"
        },
        "auto_stop_max_duration_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 4: Maximaldauer (Standard 240)"
        },
        "auto_stop_warning_s": {
          "type": "integer",
          "minimum": 0,
          "description": "Hinweis vor dem Stopp (Standard 60)"
        },
        "auto_stop_extend_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Verlängerung per Tipp (Standard 15)"
        },
        "default_layout": {
          "$ref": "#/$defs/DashboardLayout"
        },
        "default_ink_mode": {
          "$ref": "#/$defs/InkMode"
        },
        "toolbar_side": {
          "$ref": "#/$defs/ToolbarSide"
        }
      }
    },
    "PenSettings": {
      "type": "object",
      "required": ["double_tap", "squeeze", "shape_recognition", "favorite_colors"],
      "additionalProperties": false,
      "properties": {
        "double_tap": {
          "$ref": "#/$defs/PencilDoubleTapAction"
        },
        "squeeze": {
          "$ref": "#/$defs/PencilSqueezeAction"
        },
        "shape_recognition": {
          "type": "boolean",
          "description": "Formerkennung (F-INK-09, ab Phase 3)"
        },
        "favorite_colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HexColor"
          },
          "maxItems": 8
        }
      }
    },
    "DataSettings": {
      "type": "object",
      "required": ["backup_target", "backup_encryption", "backup_time"],
      "additionalProperties": false,
      "properties": {
        "backup_target": {
          "type": ["string", "null"],
          "description": "Absoluter Pfad, null = keine Backups"
        },
        "backup_encryption": {
          "type": "boolean",
          "description": "age mit Passphrase (P1). Die Passphrase steht nie in den Einstellungen"
        },
        "backup_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Ortszeit des Macs (Standard 03:00)"
        }
      }
    },
    "Settings": {
      "type": "object",
      "description": "GET /settings: alle Phase-1-Bereiche, fehlende Werte mit Standard aufgefüllt. Geräte stehen unter /devices.",
      "required": ["general", "lecture", "pen", "data"],
      "additionalProperties": false,
      "properties": {
        "general": {
          "$ref": "#/$defs/GeneralSettings"
        },
        "lecture": {
          "$ref": "#/$defs/LectureSettings"
        },
        "pen": {
          "$ref": "#/$defs/PenSettings"
        },
        "data": {
          "$ref": "#/$defs/DataSettings"
        }
      }
    },
    "GeneralSettingsUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_lang": {
          "$ref": "#/$defs/Lang"
        },
        "appearance": {
          "$ref": "#/$defs/Appearance"
        }
      }
    },
    "LectureSettingsUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "microphone_id": {
          "type": ["string", "null"],
          "maxLength": 256,
          "description": "deviceId aus MediaDevices, null = Standardmikrofon"
        },
        "auto_stop_after_end_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 1: Kalenderende + X min … (Standard 10)"
        },
        "auto_stop_quiet_window_min": {
          "type": "integer",
          "minimum": 1,
          "description": "… und X min keine Sprache (Standard 3)"
        },
        "auto_stop_hard_after_end_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 2: Kalenderende + X min (Standard 30)"
        },
        "auto_stop_silence_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 3: Stille ≥ X min (Standard 15)"
        },
        "auto_stop_max_duration_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Regel 4: Maximaldauer (Standard 240)"
        },
        "auto_stop_warning_s": {
          "type": "integer",
          "minimum": 0,
          "description": "Hinweis vor dem Stopp (Standard 60)"
        },
        "auto_stop_extend_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Verlängerung per Tipp (Standard 15)"
        },
        "default_layout": {
          "$ref": "#/$defs/DashboardLayout"
        },
        "default_ink_mode": {
          "$ref": "#/$defs/InkMode"
        },
        "toolbar_side": {
          "$ref": "#/$defs/ToolbarSide"
        }
      }
    },
    "PenSettingsUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "double_tap": {
          "$ref": "#/$defs/PencilDoubleTapAction"
        },
        "squeeze": {
          "$ref": "#/$defs/PencilSqueezeAction"
        },
        "shape_recognition": {
          "type": "boolean",
          "description": "Formerkennung (F-INK-09, ab Phase 3)"
        },
        "favorite_colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HexColor"
          },
          "maxItems": 8
        }
      }
    },
    "DataSettingsUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backup_target": {
          "type": ["string", "null"],
          "description": "Absoluter Pfad, null = keine Backups"
        },
        "backup_encryption": {
          "type": "boolean",
          "description": "age mit Passphrase (P1). Die Passphrase steht nie in den Einstellungen"
        },
        "backup_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Ortszeit des Macs (Standard 03:00)"
        }
      }
    },
    "SettingsUpdate": {
      "type": "object",
      "description": "PATCH /settings: nur die angegebenen Felder ändern sich. Antwort: Settings",
      "additionalProperties": false,
      "properties": {
        "general": {
          "$ref": "#/$defs/GeneralSettingsUpdate"
        },
        "lecture": {
          "$ref": "#/$defs/LectureSettingsUpdate"
        },
        "pen": {
          "$ref": "#/$defs/PenSettingsUpdate"
        },
        "data": {
          "$ref": "#/$defs/DataSettingsUpdate"
        }
      }
    },
    "ModuleSettings": {
      "type": "object",
      "description": "module.settings (W-06 Option A, 03 §3). Fehlender Schlüssel = globaler Standard aus Settings.lecture",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "#/$defs/DashboardLayout"
        },
        "column_widths": {
          "$ref": "#/$defs/ColumnWidths"
        },
        "ink_mode": {
          "$ref": "#/$defs/InkMode"
        }
      }
    },
    "ModuleSettingsUpdate": {
      "type": "object",
      "description": "Teil von ModuleUpdate.settings: Schlüssel für Schlüssel zusammenführen, null entfernt den Schlüssel",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardLayout"
            },
            {
              "type": "null"
            }
          ]
        },
        "column_widths": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnWidths"
            },
            {
              "type": "null"
            }
          ]
        },
        "ink_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/InkMode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
