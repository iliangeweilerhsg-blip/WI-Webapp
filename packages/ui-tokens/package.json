{
  "name": "@sg/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design-Tokens (07 §8): eine JSON-Quelle, daraus CSS-Variablen (Web) und Swift-Konstanten (iPad)",
